# Resume import (POST /api/resume-import). Copy to .env.local and fill in. Never commit real values.
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_GENERATION_MODEL=
# Shared secret for callers that aren't a signed-in browser (the mobile app), sent as the x-api-key header.
RESUME_IMPORT_API_KEY=

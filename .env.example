# Copy this file to .env (public values) and .env.local (secrets). Both are git-ignored. Never commit real values.

# Public values, baked into the browser bundle at build time.
NEXT_PUBLIC_API_URL=https://api.job4.online
NEXT_PUBLIC_JOB_BOARD_URL=https://main.job4.online

# Resume import (POST /api/resume-import). Secrets: put these in .env.local (and .env.test.local for the live tests).
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_GENERATION_MODEL=
# Shared secret for callers that aren't a signed-in browser (the mobile app), sent as the x-api-key header.
RESUME_IMPORT_API_KEY=

# Per-user daily allowance for the AI endpoints (in-memory, per server instance). Optional. Defaults: 10 imports and 5 analyses a day; 0 turns one off.
RESUME_IMPORT_DAILY_LIMIT=
RESUME_ANALYSIS_DAILY_LIMIT=
